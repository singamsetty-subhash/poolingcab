# ===================================================================
# Local Environment Configuration (Free & Open Source Map Stack)
# ===================================================================
# Maps: OpenStreetMap & OSRM (100% Free, Zero API Keys Required)
MAPS_PROVIDER=openstreetmap

# Database (MySQL root/root)
DB_URL=jdbc:mysql://localhost:3306/rideshare?createDatabaseIfNotExist=true&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Admin & Security
ADMIN_EMAIL=admin@commonway.com
ADMIN_PASSWORD=admin123
JWT_SECRET=local-dev-change-this-secret-before-deploying-2026
